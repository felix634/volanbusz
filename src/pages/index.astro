---
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/MemberCard.jsx';

// ADATOK - Itt tudod átírni a szövegeket
const members = [
  { 
    name: "Árpi", 
    imgNormal: "/arpi.jpg", 
    imgFunny: "/arpi_funny.jpg", 
    desc: "A sofőrök réme." 
  },
  { 
    name: "Félix", 
    imgNormal: "/felix.jpg", 
    imgFunny: "/felix_funny.jpg", 
    desc: "Csak egy megállót akartam..." 
  },
  { 
    name: "Zalán", 
    imgNormal: "/zalan.jpg", 
    imgFunny: "/zalan_funny.jpg", 
    desc: "Mikor indulunk már?" 
  },
  { 
    name: "Bence", 
    imgNormal: "/bence.jpg", 
    imgFunny: "/bence_funny.jpg", 
    desc: "Bérletet felmutatni!" 
  },
  { 
    name: "Dani", 
    imgNormal: "/dani.jpg", 
    imgFunny: "/dani_funny.jpg", 
    desc: "Az igazi kalauz." 
  },
  { 
    name: "Boti", 
    imgNormal: "/boti.jpg", 
    imgFunny: "/boti_funny.jpg", 
    desc: "A hátsó ülés császára." 
  },
];
---

<Layout title="Volánbusz Nyrt.">
  <main class="relative">
    
    <section class="h-screen flex flex-col items-center justify-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-yellow-600/20 via-slate-950 to-slate-950 z-0"></div>
      
      <div class="z-10 text-center px-4 animate-fade-in-up">
        <h1 class="text-6xl md:text-9xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-yellow-600 mb-6 drop-shadow-lg">
          VOLÁNBUSZ <br/> <span class="text-white">NYRT.</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-400 mb-10 max-w-2xl mx-auto">
          A hivatalos baráti társaság, ahol a menetrend csak tájékoztató jellegű.
        </p>
        <a href="#csapat" class="px-8 py-4 bg-yellow-500 hover:bg-yellow-400 text-slate-900 font-bold rounded-full transition-all hover:scale-110 shadow-[0_0_20px_rgba(234,179,8,0.5)]">
          ISMERD MEG A CSAPATOT
        </a>
      </div>
    </section>

    <section class="py-20 px-4 bg-slate-900/50">
        <div class="max-w-6xl mx-auto rounded-3xl overflow-hidden shadow-2xl border-4 border-slate-800 rotate-1 hover:rotate-0 transition-all duration-700">
             <img src="/group.jpg" alt="A Volánbusz Nyrt. Csapata" class="w-full h-auto object-cover grayscale hover:grayscale-0 transition-all duration-1000" />
        </div>
    </section>

    <section id="csapat" class="py-24 px-4 max-w-7xl mx-auto">
      <h2 class="text-4xl md:text-6xl font-bold text-center mb-16 text-white">
        A <span class="text-yellow-500">Munkatársak</span>
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 justify-items-center">
        {members.map((member) => (
          /* client:visible kell, hogy a React működjön, amikor odagörgetsz */
          <MemberCard client:visible 
            name={member.name} 
            imgNormal={member.imgNormal} 
            imgFunny={member.imgFunny} 
            description={member.desc} 
          />
        ))}
      </div>
    </section>

    <footer class="py-10 text-center border-t border-slate-800 text-slate-500">
      <p>&copy; {new Date().getFullYear()} Volánbusz Nyrt. Minden jog fenntartva. | Nem állunk kapcsolatban a valódi Volánbusszal (sajnos).</p>
    </footer>

  </main>
</Layout>

<style>
  /* Extra CSS a 3D hatáshoz a React komponenshez szükséges segédosztályok */
  .perspective-1000 {
    perspective: 1000px;
  }
  .backface-hidden {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 1s ease-out forwards;
  }
</style>